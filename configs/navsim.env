# Environment for the NAVSIM probes, scene sampling and PDM scoring (sourced by scripts/08_navsim.sh).
# The paths themselves are set in configs/paths.env (NUPLAN_MAPS_ROOT, OPENSCENE_DATA_ROOT, NAVSIM_EXP_ROOT, NAVSIM_CKPT).
export NUPLAN_MAP_VERSION=${NUPLAN_MAP_VERSION:-nuplan-maps-v1.0}
export TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1   # ReCogDrive / DiffusionDrive checkpoints are pickled Lightning checkpoints
export PYTHONDONTWRITEBYTECODE=1
