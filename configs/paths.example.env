# FROST: machine-specific locations. Copy to configs/paths.env, edit, and `source configs/paths.env`
# (the launchers in scripts/ source it automatically if it exists; override the file with FROST_ENV=<file>).

# --- Data and outputs -------------------------------------------------------------------------------
export FROST_ARTIFACTS=${FROST_ARTIFACTS:-$PWD/artifacts}   # probe plans, context caches and analysis outputs (names as in results/)
export FROST_DATA=${FROST_DATA:-$FROST_ARTIFACTS}           # context caches; the analyses' defaults expect them next to the artifacts
export FROST_RESULTS=${FROST_RESULTS:-$PWD/results}         # released summaries read by reproduce/
export FROST_OUTPUT=${FROST_OUTPUT:-$PWD/reproduce/output}  # generated tables and figures

# --- Hugging Face (models and PhysicalAI-AV). Authenticate with `huggingface-cli login` or export HF_TOKEN. --
export HF_HOME=${HF_HOME:-$HOME/.cache/huggingface}
# Optional explicit snapshot paths (default: the pinned revisions in frost/paths.py under $HF_HOME/hub)
# export FROST_A15_CHECKPOINT=$HF_HOME/hub/models--nvidia--Alpamayo-1.5-10B/snapshots/7aba8293c09993f2e125c6819df05d7fa3e873ea
# export FROST_R1_CHECKPOINT=$HF_HOME/hub/models--nvidia--Alpamayo-R1-10B/snapshots/d72c6a2757b10cacb69b688ca66ccfad3dafbf37
# export FROST_PHYSICALAI_INDEX=$HF_HOME/hub/datasets--nvidia--PhysicalAI-Autonomous-Vehicles/snapshots/dfcc35f941c38f050e9ce256a4c0aff9e33615b9
export FROST_QWENDRIVE_MODEL=${FROST_QWENDRIVE_MODEL:-$HF_HOME/hub/models--Qwen--Qwen-Drive-1.0-4B/snapshots/28484089a7cc8c335cf5089fb0745cf7c49b6eaa}
export FROST_COSMOS3_NANO_MODEL=${FROST_COSMOS3_NANO_MODEL:-$HF_HOME/hub/models--nvidia--Cosmos3-Nano/snapshots/e59a53c25979a090fa8706c9acc0c254a6e89b92}
export FROST_SIMWAM_HUB=${FROST_SIMWAM_HUB:-$HF_HOME/hub}   # hub cache that holds H-EmbodVis/SimWAM

# --- Upstream source trees (clone at the commits listed in THIRD_PARTY.md) ----------------------------
export ALPAMAYO15_SRC=${ALPAMAYO15_SRC:-$PWD/third_party/alpamayo1.5}     # NVlabs/alpamayo1.5
export ALPAMAYO2_SRC=${ALPAMAYO2_SRC:-$PWD/third_party/alpamayo2}         # NVlabs/alpamayo2
export ALPAMAYO_R1_SRC=${ALPAMAYO_R1_SRC:-$PWD/third_party/alpamayo}      # NVlabs/alpamayo (Alpamayo-R1)
export QWENDRIVE_SRC=${QWENDRIVE_SRC:-$PWD/third_party/Qwen-Drive-1.0}    # QwenLM/Qwen-Drive-1.0
export FLASHDRIVE_SRC=${FLASHDRIVE_SRC:-$PWD/third_party/flashdrive}      # z-lab/flashdrive
export SIMWAM_SRC=${SIMWAM_SRC:-$PWD/third_party/simwam}                  # H-EmbodVis/SimWAM
export SIMWAM_ASSETS=${SIMWAM_ASSETS:-$PWD/third_party/simwam_assets}
export RECOGDRIVE_SRC=${RECOGDRIVE_SRC:-$PWD/third_party/recogdrive}      # xiaomi-research/recogdrive
export DIFFUSIONDRIVE_SRC=${DIFFUSIONDRIVE_SRC:-$PWD/third_party/diffusiondrive}  # hustvl/DiffusionDrive
export ALPASIM_ROOT=${ALPASIM_ROOT:-$PWD/third_party/alpasim}             # NVlabs/alpasim + patches/alpasim/frost_sampler.patch
export WAYMO_RFS_OFFICIAL=${WAYMO_RFS_OFFICIAL:-$PWD/third_party/waymo_rfs_official/rater_feedback_utils.py}
export LIBERO_CONFIG=${LIBERO_CONFIG:-$PWD/third_party/libero_config}

# --- Datasets with their own access terms -------------------------------------------------------------
export WOD_E2E_ROOT=${WOD_E2E_ROOT:-$PWD/datasets/wod_e2e}   # Waymo Open Dataset end-to-end driving (val shards)
# NAVSIM / OpenScene (navtest) and nuPlan maps, as required by NAVSIM:
export NUPLAN_MAP_VERSION=nuplan-maps-v1.0
export NUPLAN_MAPS_ROOT=${NUPLAN_MAPS_ROOT:-$PWD/datasets/navsim/maps}
export OPENSCENE_DATA_ROOT=${OPENSCENE_DATA_ROOT:-$PWD/datasets/navsim}
export NAVSIM_EXP_ROOT=${NAVSIM_EXP_ROOT:-$PWD/datasets/navsim_exp}
export NAVSIM_CKPT=${NAVSIM_CKPT:-$PWD/checkpoints/navsim}    # ReCogDrive-2B-{IL,RL}, ReCogDrive-VLM-2B, DiffusionDrive, resnet34.a1_in1k

# --- Python interpreters, one per isolated environment (see envs/) -------------------------------------
export PY_ANALYSIS=${PY_ANALYSIS:-python}          # envs/analysis.txt (numpy/scipy/pandas/polars/matplotlib)
export PY_ALPAMAYO=${PY_ALPAMAYO:-python}          # envs/alpamayo.txt (Alpamayo-1.5/R1/2 probes)
export PY_QWENDRIVE=${PY_QWENDRIVE:-python}        # envs/qwendrive.txt
export PY_FLASHDRIVE=${PY_FLASHDRIVE:-python}      # envs/flashdrive.txt
export PY_SIMWAM=${PY_SIMWAM:-python}              # envs/simwam.txt
export PY_COSMOS=${PY_COSMOS:-python}              # envs/cosmos.txt
export PY_RECOGDRIVE=${PY_RECOGDRIVE:-python}      # envs/navsim_recogdrive.txt (Python 3.10)
export PY_DIFFUSIONDRIVE=${PY_DIFFUSIONDRIVE:-python}  # envs/navsim_diffusiondrive.txt (Python 3.9)
export PY_ROBOT=${PY_ROBOT:-python}                # envs/robot.txt (LeRobot + LIBERO)

# --- Determinism (as in every original run) -------------------------------------------------------------
export CUBLAS_WORKSPACE_CONFIG=:4096:8
