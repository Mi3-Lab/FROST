+# SPDX-License-Identifier: Apache-2.0
+"""FROST research hook: replace the flow sampler of an Alpamayo model in-process.
+
+Inactive unless FROST_METHOD is set, so the default driver behaviour is unchanged.
+  FROST_METHOD=euler|heun  FROST_STEPS=int  FROST_TAU=float (initial-noise scale)
+Integration runs on a uniform grid from t=0 (noise) to t=1 (actions), the
+convention of the Alpamayo flow-matching sampler, with classifier-free guidance
+applied exactly as the model's own sampler would when it is enabled.
+"""
+
+from __future__ import annotations
+
+import inspect
+import logging
+import os
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+
+def install_frost_sampler(model) -> None:
+    method = os.environ.get("FROST_METHOD")
+    if not method:
+        return
+    steps = int(os.environ.get("FROST_STEPS", "10"))
+    tau = float(os.environ.get("FROST_TAU", "1.0"))
+    if method not in ("euler", "heun"):
+        raise ValueError(f"FROST_METHOD must be euler or heun, got {method!r}")
+    diffusion = model.diffusion
+    original = diffusion.sample
+    signature = inspect.signature(original)
+
+    @torch.no_grad()
+    def sample(*args, **kwargs):
+        bound = signature.bind_partial(*args, **kwargs).arguments
+        if bound.get("return_all_steps"):
+            return original(*args, **kwargs)
+        step_fn = bound["step_fn"]
+        unguided = bound.get("unguided_step_fn")
+        use_cfg = bound.get("use_classifier_free_guidance")
+        if use_cfg is None:
+            use_cfg = diffusion.use_classifier_free_guidance
+        weight = bound.get("inference_guidance_weight")
+        if weight is None:
+            weight = diffusion.inference_guidance_weight
+
+        def field(x, t):
+            v = step_fn(x=x, t=t)
+            return (1 - weight) * unguided(x=x, t=t) + weight * v if use_cfg else v
+
+        batch = bound["batch_size"]
+        device = bound.get("device", "cuda")
+        x = tau * torch.randn(batch, *diffusion.x_dims, device=device)
+        shape = [1] * len(diffusion.x_dims)
+        h = 1.0 / steps
+        for i in range(steps):
+            t = torch.full((batch, *shape), i * h, device=device)
+            v = field(x, t)
+            if method == "heun":
+                x = x + 0.5 * h * (v + field(x + h * v, t + h))
+            else:
+                x = x + h * v
+        return x
+
+    diffusion.sample = sample
+    logger.info("FROST sampler active: %s%d tau=%s", method, steps, tau)
